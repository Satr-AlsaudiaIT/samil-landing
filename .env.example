# --- Admin authentication ---
# Used to sign the admin session cookie. Use a long random string in production.
SESSION_SECRET=please-change-this-to-a-long-random-string

# Default admin seed (only used the first time the DB is created)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Samel@2026

# --- SMTP (Nodemailer) for replying to client messages ---
# Example: Gmail with App Password, Zoho, or any SMTP server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Samel <no-reply@samel.sa>"
